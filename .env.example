# =============================================================================
# GRAFIKARSA WEB - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local (for local dev) or .env (for docker)
# =============================================================================

# API Configuration
# For Local Dev (no docker): http://localhost:8080/api/v1
# For Docker (browser access): http://localhost:8080/api/v1 (browser still communicates to localhost)
# For SSR (server-to-server): You might need http://api:8080/api/v1 if using internal network
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
